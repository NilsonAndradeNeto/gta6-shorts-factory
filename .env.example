# Copie para .env APENAS para testes locais. Nunca versione o .env.
# No GitHub Actions estes valores são GitHub Secrets (Settings > Secrets and variables > Actions).

# LLM gratuito — pelo menos um (GitHub Models foi descontinuado em 30/07/2026).
GEMINI_API_KEY=               # aistudio.google.com/apikey (camada gratuita)
GROQ_API_KEY=                 # console.groq.com/keys (camada gratuita)

# Telegram (entrega dos vídeos para postar no TikTok)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# YouTube (gerados por: python -m factory.cli auth --client-secrets client_secret.json)
YT_CLIENT_ID=
YT_CLIENT_SECRET=
YT_REFRESH_TOKEN=

# 1 = renderiza e valida, mas não envia ao YouTube
FACTORY_DRY_RUN=1

# Opcionais
# TTS_PRIMARY=piper            # piper | edge
# PIPER_VOICE=pt_BR-faber-medium   # pt_BR-cadu-medium | pt_BR-jeff-medium
